# LLM (OpenAI-compatible API)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
PIYA_MODEL=gpt-4o-mini

# Embeddings
PIYA_EMBEDDING_MODEL=text-embedding-3-small

# Agent behavior
PIYA_WORKSPACE=./workspace
PIYA_DATA_DIR=./data
PIYA_POLL_INTERVAL_SEC=30
PIYA_MAX_CYCLES=0
PIYA_MIN_ACCURACY=0.7
PIYA_MAX_RETRIES=3

# Shell commands outside the auto-allow list: ask (default), allow, or deny
# PIYA_SHELL_POLICY=ask
